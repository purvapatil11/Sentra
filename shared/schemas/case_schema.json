{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentra Fraud Case",
  "description": "Fraud detection result generated by the Sentra Blue Team.",

  "type": "object",

  "required": [
    "case_id",
    "transaction_id",
    "xgboost_score",
    "fraud_probability",
    "anomaly_score",
    "is_anomaly",
    "risk_score",
    "decision",
    "action",
    "risk_level",
    "explanation",
    "top_risk_factors"
  ],

  "properties": {
    "case_id": {
      "type": "string"
    },

    "transaction_id": {
      "type": "string"
    },

    "xgboost_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "fraud_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "anomaly_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "is_anomaly": {
      "type": "boolean"
    },

    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },

    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "MONITOR",
        "VERIFY",
        "BLOCK"
      ]
    },

    "action": {
      "type": "string",
      "enum": [
        "ALLOW",
        "MONITOR",
        "VERIFY",
        "BLOCK"
      ]
    },

    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },

    "explanation": {
      "type": "string"
    },

    "top_risk_factors": {
      "type": "array",

      "items": {
        "type": "object",

        "required": [
          "feature",
          "value",
          "reason"
        ],

        "properties": {
          "feature": {
            "type": "string"
          },

          "value": {},

          "reason": {
            "type": "string"
          }
        },

        "additionalProperties": false
      }
    },

    "model_version": {
      "type": "string"
    }
  },

  "additionalProperties": false
}
